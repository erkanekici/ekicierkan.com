public static int closedPaths(int number) {
    
        int result = 0;
        Integer[] arr = new Integer[]{0,4,6,9};
        List<Integer> listOneValuableClosedPaths = Arrays.asList(arr);
        Integer twoValuableNumber = 8;        
       
        while (number > 0) {
            if(listOneValuableClosedPaths.contains(number % 10)){
                result = result + 1;
            }
            else if(twoValuableNumber == number % 10){
                result = result + 2;
            }        
            number = number / 10;
        }
        return result;
    }
