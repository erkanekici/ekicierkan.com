    static void pattern(int n, int i) 
    {       
        if (n == 0) 
            return;
            
        printn(i);
		// printn(n); tersten
        System.out.println(); 
  
        // recursively calling pattern() 
        pattern(n - 1, i + 1); 
    } 
    
    static void printn(int num){
        if (num == 0) 
        return;        
       
        System.out.print ("* ");
  
        // recursively calling printn() 
        printn(num - 1); 
    }
    
