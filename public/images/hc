public static int isPrime(long n) {
       
        List<Integer> recordList = new ArrayList<Integer>();
        for (int i=1;i<=n/2;i++){
            if(recordList.size()>1){
                break;
            }
            if (n%i==0){
                recordList.add(i);                
            }
        }        
        if(recordList.size()>1){
            return recordList.get(1);
        }else{
            return recordList.get(0);
        }   
    }

